    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst results = [];\n\nallItems.forEach(item => {\n  const jobs = item.json.results || [];\n  jobs.forEach(job => {\n    results.push({ json: {\n      id: String(job.id),\n      titre: job.title,\n      entreprise: job.company.display_name,\n      description: job.description.slice(0, 300),\n      lien: job.redirect_url,\n      date: job.created,\n      lieu: job.location.display_name\n    }});\n  });\n});\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        80
      ],
      "id": "a574ed64-53a6-4afc-9083-33895c018e25",
      "name": "Parser les offres"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o",
          "mode": "list",
          "cachedResultName": "GPT-4o"
        },
        "responses": {
          "values": [
            {
              "content": "=Tu es un expert RH spécialisé en recrutement tech.\n\nVoici une offre d'emploi :\n- Titre : {{ $json.titre }}\n- Entreprise : {{ $json.entreprise }}\n- Description : {{ $json.description }}\n\nVoici le profil du candidat :\n- Compétences : [VOS_COMPETENCES — ex: n8n, Python, APIs REST, JavaScript...]\n- Formation : [VOTRE_FORMATION — ex: Master informatique]\n- Expérience : [VOTRE_EXPERIENCE — ex: 3 ans développeur web]\n\nScore cette offre de 0 à 100 selon le match avec le profil.\n\nRetourne UNIQUEMENT ce JSON :\n{\"score\": 85, \"raison\": \"...\", \"a_postuler\": true}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        1024,
        -16
      ],
      "id": "55649b8e-16d6-4133-a173-cfc3e9050d94",
      "name": "Scorer l'offre d'emploi",
      "credentials": {
        "openAiApi": {
          "id": "VOTRE_CREDENTIAL_OPENAI_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const raw = item.json.output[0].content[0].text;\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  try {\n    const parsed = JSON.parse(cleaned);\n    return { json: {\n      titre: item.json.titre,\n      entreprise: item.json.entreprise,\n      lien: item.json.lien,\n      score: parsed.score,\n      raison: parsed.raison,\n      a_postuler: parsed.a_postuler\n    }};\n  } catch(e) {\n    return { json: { erreur: 'parsing échoué', raw: raw }};\n  }\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1328,
        -48
      ],
      "id": "66583881-2130-4adb-90c6-fc45662c0f26",
